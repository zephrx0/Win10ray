<UserControl x:Class="XrayMetro.Views.RoutingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:XrayMetro.Views" xmlns:loc="clr-namespace:XrayMetro.Services">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></UserControl.Resources>
 <ScrollViewer Padding="0,0,8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel MaxWidth="620" HorizontalAlignment="Left" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" local:MetroMotion.Animate="True">
   <TextBlock Text="{loc:Tr Routing}" Style="{StaticResource PageTitle}"/>
   <local:SettingsRow Label="{loc:Tr Mode}"><ComboBox ItemsSource="{Binding ConnectionModes}" SelectedIndex="{Binding ConnectionModeIndex, Mode=TwoWay}" IsEnabled="{Binding CanEditConnection}"/></local:SettingsRow>
   <ToggleButton Content="{loc:Tr BlockAds}" IsChecked="{Binding BlockAds}" IsEnabled="{Binding CanEditConnection}" Margin="0,4,0,24"/>
   <ToggleButton Content="{loc:Tr BypassRussia}" IsChecked="{Binding BypassRussia}" IsEnabled="{Binding CanEditConnection}" Margin="0,0,0,24"/>
   <ToggleButton Content="DNS over HTTPS" IsChecked="{Binding UseDnsOverHttps}" IsEnabled="{Binding CanEditConnection}" Margin="0,0,0,20"/>
   <StackPanel Visibility="{Binding UseDnsOverHttps, Converter={StaticResource BoolVisibility}}"><local:SettingsRow Label="{loc:Tr DohUrl}"><TextBox x:Name="DohUrlBox" MaxLength="2048" Text="{Binding DnsOverHttpsUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConnection}"/></local:SettingsRow><TextBlock Text="{loc:Tr InvalidDoh}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,16" Visibility="{Binding HasDnsError, Converter={StaticResource BoolVisibility}}"/></StackPanel>
   <TextBlock Text="{loc:Tr ProcessRouting}" FontSize="20" Margin="0,12,0,12"/>
   <TextBlock Text="{loc:Tr ProcessRoutingHint}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,20"/>
   <StackPanel IsEnabled="{Binding CanEditProcessRules}">
    <local:SettingsRow Label="{loc:Tr DefaultRoute}"><ComboBox ItemsSource="{Binding DefaultRouteChoices}" SelectedIndex="{Binding DefaultRouteIndex, Mode=TwoWay}"/></local:SettingsRow>
    <TextBox Text="{Binding ProcessInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="1024" Margin="0,0,0,10" AutomationProperties.Name="{loc:Tr ProcessName}"/>
    <WrapPanel Margin="0,0,0,10"><Button Content="{loc:Tr RunningProcesses}" Command="{Binding SelectRunningProcessCommand}" Margin="0,0,8,8"/><Button Content="{loc:Tr Browse}" Command="{Binding BrowseProcessCommand}" Margin="0,0,8,8"/><ComboBox ItemsSource="{Binding ProcessActions}" SelectedItem="{Binding ProcessAction}" Width="100" Margin="0,0,8,8"/><Button Content="{loc:Tr Add}" Command="{Binding AddProcessRuleCommand}" Margin="0,0,0,8"/></WrapPanel>
    <ItemsControl ItemsSource="{Binding ProcessRules}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,8" Background="{DynamicResource TileBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Value}" Padding="10,8" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ActionText}" VerticalAlignment="Center" HorizontalAlignment="Center"/><Button Grid.Column="2" Content="&#xE74D;" Style="{StaticResource IconButton}" Width="40" Height="40" Command="{Binding DataContext.DeleteProcessRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{loc:Tr Delete}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>
