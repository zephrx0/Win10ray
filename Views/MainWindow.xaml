         <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,24" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Tr NoSearchResults}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=ServerList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding HasServers}" Value="False"><Setter Property="Text" Value="{loc:Tr NoServers}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>

