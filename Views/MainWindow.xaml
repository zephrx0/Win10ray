      <ToggleButton Grid.Row="3" Content="DNS over HTTPS" IsChecked="{Binding UseDnsOverHttps}" IsEnabled="{Binding CanEditConnection}" Margin="0,0,0,20"/>
      <Grid Grid.Row="4" Visibility="{Binding UseDnsOverHttps, Converter={StaticResource BoolVisibility}}" local:MetroMotion.Animate="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><local:SettingsRow Label="{loc:Tr DohUrl}" Margin="0"><TextBox x:Name="DohUrlBox" HorizontalAlignment="Stretch" MaxLength="2048" Text="{Binding DnsOverHttpsUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditConnection}" AutomationProperties.Name="{loc:Tr DohUrl}"/></local:SettingsRow><TextBlock Grid.Row="1" Text="{loc:Tr InvalidDoh}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" Visibility="{Binding HasDnsError, Converter={StaticResource BoolVisibility}}"/></Grid>
     </Grid></ScrollViewer>
     <Grid Style="{StaticResource EntrancePanel}" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=3}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="{loc:Tr Logs}" Style="{StaticResource PageTitle}"/><WrapPanel Grid.Row="1" Margin="0,0,0,18"><Button Content="{loc:Tr Copy}" Command="{Binding CopyLogsCommand}" Margin="0,0,8,0"/><Button Content="{loc:Tr Clear}" Command="{Binding ClearLogsCommand}"/></WrapPanel><TextBox Grid.Row="2" x:Name="LogBox" Text="{Binding Logs, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" TextChanged="LogsTextChanged" AutomationProperties.Name="{loc:Tr Logs}"/></Grid>
     <ScrollViewer Padding="0,0,8,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=4}"><Grid Style="{StaticResource EntrancePanel}" MaxWidth="520" HorizontalAlignment="Left" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{loc:Tr General}" Style="{StaticResource PageTitle}"/>
