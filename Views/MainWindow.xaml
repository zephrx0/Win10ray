        <WrapPanel Grid.Row="2" Margin="0,16,0,0"><Button Content="{loc:Tr Update}" Command="{Binding UpdateSubscriptionsCommand}" Margin="0,0,8,8"/><Button Content="{loc:Tr Delete}" Command="{Binding DeleteSubscriptionCommand}" Margin="0,0,0,8"/></WrapPanel>
