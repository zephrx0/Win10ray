      <local:SettingsRow Grid.Row="10" Label="{loc:Tr ClientVersion}" Margin="0,0,0,12"><TextBlock x:Name="ClientVersionText" Text="{Binding ClientVersion}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" FontSize="14"/></local:SettingsRow>
