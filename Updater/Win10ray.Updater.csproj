<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>12</LangVersion>
    <AssemblyName>updater</AssemblyName>
    <Version>1.4.2-experimental.1</Version>
    <Product>Win10ray Updater</Product>
    <ApplicationIcon>../Assets/Win10ray.ico</ApplicationIcon>
    <ApplicationManifest>../app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Services/UpdateService.cs" Link="UpdateService.cs" />
    <Compile Include="../Services/UpdatePackage.cs" Link="UpdatePackage.cs" />
    <Compile Include="../Services/ExeInstallerService.cs" Link="ExeInstallerService.cs" />
  </ItemGroup>
</Project>
